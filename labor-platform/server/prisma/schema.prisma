generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AchievementReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model TaskGroup {
  id        String   @id
  name      String   @unique
  icon      String
  type      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  
  courses Course[]
  badges  Badge[]
}

model Grade {
  id        Int      @id
  name      String   @unique
  createdAt DateTime @default(now())
  
  students Student[]
  courses  Course[]
}

model Course {
  id          String   @id @default(uuid())
  
  gradeId     Int
  grade       Grade    @relation(fields: [gradeId], references: [id])
  semesterId  Int
  taskGroupId String
  taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id])
  
  title       String
  emoji       String   @default("🌱")
  color       String   @default("#E8F5E9")
  description String
  objectives  String
  materials   String
  steps       String
  safetyTips  String
  
  coverSvg    String?
  coverImage  String?  // 上传的封面图片路径
  demoVideo   String?  // 演示视频 URL 或上传路径
  demoImages  String?  // 演示图片路径 JSON 数组
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([gradeId, semesterId])
  @@index([taskGroupId])
}

model Student {
  id            String   @id @default(uuid())
  
  studentId     String   @unique
  password      String
  nickname      String
  avatarEmoji   String   @default("🌟")
  role          Role     @default(STUDENT)
  
  gradeId       Int
  grade         Grade    @relation(fields: [gradeId], references: [id])
  classCode     String
  
  totalAchievements Int @default(0)
  totalLikes        Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  achievements Achievement[]
  likes       Like[]
  badges      StudentBadge[]
  evaluations Evaluation[]
  reviewedAchievements Achievement[] @relation("AchievementReviewer")

  @@index([gradeId, classCode])
}

model Achievement {
  id          String   @id @default(uuid())
  
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  courseId    String?
  courseTitle String?
  taskGroupId String?
  
  title       String
  description String
  reflection  String?
  images      String
  isPublic    Boolean  @default(true)

  reviewStatus  AchievementReviewStatus @default(PENDING)
  reviewComment String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    Student? @relation("AchievementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  
  evalAttitude Int @default(0)
  evalSkill    Int @default(0)
  evalResult   Int @default(0)
  
  avgAttitude Float @default(0)
  avgSkill    Float @default(0)
  avgResult   Float @default(0)
  evalCount   Int   @default(0)
  
  likesCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  likes       Like[]
  evaluations Evaluation[]

  @@index([studentId])
  @@index([reviewStatus, isPublic, createdAt])
  @@index([studentId, reviewStatus])
  @@index([taskGroupId, reviewStatus])
}

model Like {
  id            String   @id @default(uuid())
  
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())

  @@unique([studentId, achievementId])
  @@index([achievementId])
}

model Evaluation {
  id            String   @id @default(uuid())
  
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  attitude      Int
  skill         Int
  result        Int
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, achievementId])
  @@index([achievementId])
}

model EvaluationDimension {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String
  prompt      String
  weight      Float    @default(1)
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Badge {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String   @unique
  emoji       String
  description String
  category    String
  taskGroupId String
  taskGroup   TaskGroup @relation(fields: [taskGroupId], references: [id])
  threshold   Int      @default(1)
  sortOrder   Int      @default(0)
  
  createdAt DateTime @default(now())
  
  studentBadges StudentBadge[]

  @@index([taskGroupId, sortOrder])
}

model StudentBadge {
  id        String   @id @default(uuid())
  
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
}
