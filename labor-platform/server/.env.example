# =========================================
# 生产环境配置文件 (.env)
# =========================================
# 复制此文件为 .env 并修改相应值
# cp .env.example .env

# 数据库配置（SQLite 文件路径，相对于 server 目录）
DATABASE_URL="file:./dev.db"

# JWT 密钥（⚠️ 生产环境必须修改为随机字符串）
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 服务器端口
PORT=3001

# 运行环境（本地开发默认 development；生产部署时改为 production）
NODE_ENV=development

# CORS 允许的域名（逗号分隔）
# 示例: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# AI 智能体服务基础地址（可选）
# 未配置时系统会使用本地规则生成演示评价；配置后会向 ${AI_AGENT_BASE_URL}/evaluate POST 成果与评价维度
AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=
