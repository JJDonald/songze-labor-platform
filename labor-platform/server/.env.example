# =========================================
# 生产环境配置文件 (.env)
# =========================================
# 复制此文件为 .env 并修改相应值
# cp .env.example .env

# 数据库配置（SQLite 文件路径，相对于 server 目录）
DATABASE_URL="file:./dev.db"

# JWT 密钥（⚠️ 生产环境必须修改为随机字符串）
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 服务器端口
PORT=3001

# 运行环境（本地开发默认 development；生产部署时改为 production）
NODE_ENV=development

# CORS 允许的域名（逗号分隔）
# 示例: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI 智能体服务（可选，也可在管理后台动态配置，后台配置优先）
# provider: custom | openai_compatible
AI_AGENT_PROVIDER=custom
# custom 模式下会请求 ${AI_AGENT_BASE_URL}/evaluate
# openai_compatible 模式下会请求 ${AI_AGENT_BASE_URL}/chat/completions
AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=
AI_AGENT_MODEL=
# 思考等级：off | low | medium | high（也可在管理后台配置）
AI_AGENT_THINKING_LEVEL=off
